# Optional settings file. Never share it. Instagram/YouTube logins are NOT typed here:
# START_HERE.bat opens a browser window for those and saves them per project in .reeler/.

# --- Claude (AI scene analysis + captions) - optional ---
ANTHROPIC_API_KEY=

# --- Official Instagram Graph API (uploader: graph) ---
# Instagram professional (Business/Creator) account ID and a long-lived access token.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Only needed for `python -m reeler refresh-token` with Facebook-Login tokens
FB_APP_ID=
FB_APP_SECRET=

# --- Old single-project setup only (config.pc.yaml). Projects keep this in .reeler/<name>/account.env ---
IG_USERNAME=
IG_PASSWORD=
